<Project Sdk="Aspire.AppHost.Sdk/13.6.1">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AspireUseCliBundle>true</AspireUseCliBundle>
  </PropertyGroup>

  <ItemGroup>
    <!-- Runs the MAUI app on Windows / Android and wires its telemetry to the dashboard. Preview-only for now. -->
    <PackageReference Include="Aspire.Hosting.Maui" Version="13.6.1-preview.1.26506.6" />
    <!-- Lets the Android emulator reach the dashboard through a dev tunnel -->
    <PackageReference Include="Aspire.Hosting.DevTunnels" Version="13.6.1" />
  </ItemGroup>

</Project>
